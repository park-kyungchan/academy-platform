#!/usr/bin/env bash
# The one check of this repository. An agent runs it before a push; the CI job
# `rust` runs it unchanged. Call it from any directory, or as `bash <path>`.
#   ./check       format, clippy, offline teacher harness, academy-mcp install scripts,
#                 bun test (academy-mcp), build, tests: the default members
#   ./check all   the same steps over the whole workspace; the default members equal
#                 the workspace members, so it does what ./check does
# The steps `i6` and `python unittest (studyq-linux)` run everywhere: `i6` scans specs/ and
# modules/studyq-linux/ for secret values (privacy check I6, specs/studyq-linux/core.md R28; with
# CHECK_STUDYQ_ROSTER=<file of names, one per line> it also scans for those names and prints
# file names only), and the unit tests run the rendering tests when CHECK_STUDYQ_PYMUPDF=1 is set
# or `pymupdf` imports. CHECK_I6_ROOTS=<dir>[:<dir>...] makes `check` run only `i6` over those
# directories (used by the tests of the scan).
# The step `bun test (academy-mcp)` runs in CI (CI=true), and outside CI only when CHECK_BUN=1;
# otherwise it prints one skip line and goes on, so CI stays the gate for the module's tests.
# Where it runs it needs bun (CI installs 1.4.3 before this file; a missing bun fails with
# bun_missing); it runs
# `bun install --frozen-lockfile` (its postinstall also installs apps/academy/dc-gang-a) and
# `bun test tests` in modules/academy-workbench/tools/academy-mcp.
# Outside CI, on the host that has the build lock, it takes that lock (one Cargo
# build at a time on the host) and refuses to build under 10,240 MiB free. It
# makes its own fixture parent: a fresh mode-0700 directory under CHECK_FIXTURE_BASE
# (default: the directory of the lock file; in CI $RUNNER_TEMP), which must be
# outside any Git work tree and have trusted ancestors, and removes it on exit.
set -euo pipefail
self=$(realpath "$0")
cd "$(dirname "$self")"
mode=${1:-default}
case "$mode" in
  default | all) ;;
  *) echo "usage: ./check [all]" >&2; exit 2 ;;
esac
[ "$#" -le 1 ] || { echo "usage: ./check [all]" >&2; exit 2; }

# I6: secret values and, when a roster is given, student names, in the given directories.
# It prints `file:line` only, never the text it matched.
i6_scan() {
  local found=0 out roster
  local excl=(--exclude-dir=imported --exclude-dir=private --exclude-dir=private-students --exclude-dir=__pycache__ --exclude-dir=.git)
  local patterns=(
    '-----BEGIN [A-Z ]*PRIVATE KEY-----'
    'AKIA[0-9A-Z]{16}'
    'gh[pousr]_[A-Za-z0-9]{36,}'
    'github_pat_[A-Za-z0-9_]{20,}'
    'sk-[A-Za-z0-9]{20,}'
    'xox[abprs]-[A-Za-z0-9-]{10,}'
    'Bearer [A-Za-z0-9._~+/=-]{20,}'
    '(password|passwd|secret|api[_-]?key|access[_-]?token|auth[_-]?token|archive[_-]?key)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"'[:space:]]{8,}["'"'"']'
  )
  local pattern dir
  for dir in "$@"; do
    [ -d "$dir" ] || { echo "i6: not a directory: $dir" >&2; return 2; }
    for pattern in "${patterns[@]}"; do
      if out=$(grep -rIEin "${excl[@]}" -e "$pattern" -- "$dir" | cut -d: -f1,2); [ -n "$out" ]; then
        printf 'i6: secret-value pattern at %s\n' $out >&2
        found=1
      fi
    done
    roster=${CHECK_STUDYQ_ROSTER:-}
    if [ -n "$roster" ] && [ -r "$roster" ]; then
      if out=$(grep -v '^[[:space:]]*$' "$roster" | grep -rIlF "${excl[@]}" -f - -- "$dir"); [ -n "$out" ]; then
        printf 'i6: roster name in %s\n' $out >&2
        found=1
      fi
    fi
  done
  return $found
}
if [ -n "${CHECK_I6_ROOTS:-}" ]; then
  IFS=: read -r -a i6_roots <<<"$CHECK_I6_ROOTS"
  i6_scan "${i6_roots[@]}" || { echo "i6: failed" >&2; exit 5; }
  echo "i6: ok"
  exit 0
fi

lock=${HOST_CARGO_LOCK:-/var/lib/agent-platform/build.lock}
if [ "${CI:-}" != true ] && [ -z "${CHECK_LOCKED:-}" ] && [ -e "$lock" ]; then
  free=$(df -BM --output=avail . | tail -n 1 | tr -dc 0-9)
  if [ "$free" -lt 10240 ]; then
    echo "disk_floor@check: ${free} MiB free, 10240 needed" >&2
    exit 3
  fi
  export CHECK_LOCKED=1 CARGO_INCREMENTAL=0 CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0
  export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-2}" RUST_TEST_THREADS="${RUST_TEST_THREADS:-2}"
  exec flock "$lock" bash "$self" "$@"
fi
# Large debug symbols can exceed the bounded synthetic artifact size.
export CARGO_PROFILE_DEV_DEBUG=${CARGO_PROFILE_DEV_DEBUG:-0} CARGO_PROFILE_TEST_DEBUG=${CARGO_PROFILE_TEST_DEBUG:-0}

if [ -n "${CHECK_FIXTURE_BASE:-}" ]; then
  base=$CHECK_FIXTURE_BASE
elif [ "${CI:-}" = true ] && [ -n "${RUNNER_TEMP:-}" ]; then
  base=$RUNNER_TEMP
elif [ -e "$lock" ]; then
  base=$(dirname "$lock")
else
  base=${TMPDIR:-/tmp}
fi
fixture_parent=$(mktemp -d "$base/edu-check.XXXXXX")
chmod 0700 "$fixture_parent"
trap 'rm -rf -- "$fixture_parent"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

scope=()
if [ "$mode" = all ]; then
  scope=(--workspace)
fi

cargo fmt --all -- --check
cargo clippy ${scope[@]+"${scope[@]}"} --all-targets --locked -- -D warnings
python3 -B -m unittest discover -s crates/edu-academy-teacher/harness
echo "check: i6"
i6_scan specs modules/studyq-linux || { echo "i6: failed" >&2; exit 5; }
echo "check: python unittest (studyq-linux)"
python3 -B -m unittest discover -s modules/studyq-linux/tests
bash scripts/test-academy-mcp-install.sh
if [ "${CI:-}" = true ] || [ "${CHECK_BUN:-}" = 1 ]; then
  echo "check: bun test (academy-mcp)"
  command -v bun >/dev/null || { echo "bun_missing@check:$LINENO: bun is not on PATH" >&2; exit 4; }
  (
    cd modules/academy-workbench/tools/academy-mcp
    bun install --frozen-lockfile
    bun test tests
  )
else
  echo "check: bun test (academy-mcp) skipped outside CI (CHECK_BUN=1 runs it)"
fi
cargo build ${scope[@]+"${scope[@]}"} --bins --examples --locked
# shellcheck source=scripts/rust-test-env.sh
source scripts/rust-test-env.sh "$fixture_parent"
cargo test ${scope[@]+"${scope[@]}"} --locked
echo "check: ok"
