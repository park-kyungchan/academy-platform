            "text": "$text",
            "provenance": "$provenance",
            "written_at": "$written_at"
          }
        }
      ]
    },
    "open_reminder": {
      "description": "Create or modify a reminder with status open; without student it is a reminder of a whole class.",
      "parameters": {
        "reminder": {
          "type": {
            "ref": "reminder"
          },
          "required": true,
          "description": "The reminder, keyed by its id."
        },
        "student": {
          "type": {
            "ref": "student"
          },
          "required": false,
          "description": "The student; absent for a reminder of a whole class."
        },
        "text": {
          "type": "string",
          "required": true,
          "max_bytes": 600,
          "description": "What to remember."
        },
        "due": {
          "type": {
            "value_type": "iso_date"
          },
          "required": false,
          "max_bytes": 10,
          "description": "The date by which it is due."
        },
        "provenance": {
          "type": {
            "value_type": "provenance"
          },
          "required": false,
          "description": "Where the reminder comes from."
        },
        "updated_at": {
          "type": "string",
          "required": false,
          "max_bytes": 40,
          "description": "When the reminder was last written. A UTC time YYYY-MM-DDTHH:MM:SSZ set by the caller."
        }
      },
      "submission_criteria": [
        {
          "code": "student_missing",
          "message": "Apply register_student for this student first, or name no student.",
          "any": [
            {
              "none": [
                {
                  "present": "$student"
                }
              ]
            },
            {
              "exists": "$student"
            }
          ]
        }
      ],
      "rules": [
        {
          "create_or_modify_object": "reminder",
          "set": {
            "student": "$student",
            "text": "$text",
            "due": "$due",
            "provenance": "$provenance",
            "updated_at": "$updated_at",
            "status": "open"
          }
        }
      ]
    },
    "close_reminder": {
      "description": "Close an open reminder.",
      "parameters": {
        "reminder": {
          "type": {
            "ref": "reminder"
          },
          "required": true,
          "description": "The reminder, keyed by its id."
        },
        "updated_at": {
          "type": "string",
          "required": false,
          "max_bytes": 40,
          "description": "When the reminder was last written. A UTC time YYYY-MM-DDTHH:MM:SSZ set by the caller."
        }
      },
      "submission_criteria": [
        {
          "code": "reminder_not_open",
          "message": "The reminder is missing or not open.",
          "all": [
            {
              "exists": "$reminder"
            },
            {
              "eq": [
                "$reminder.status",
                "open"
              ]
            }
          ]
        }
      ],
      "rules": [
        {
          "modify_object": "reminder",
          "set": {
            "updated_at": "$updated_at",
            "status": "closed"
          }
        }
      ]
    },
    "prepare_counseling": {
      "description": "Create a counseling with status prepared; its key may not exist yet.",
      "parameters": {
        "counseling": {
          "type": {
            "ref": "counseling"
          },
          "required": true,
          "description": "The counseling, keyed <slug>|<date>."
        },
        "student": {
          "type": {
            "ref": "student"
          },
          "required": true,
          "description": "The student, keyed by the slug the teacher's files use."
        },
        "date": {
          "type": {
            "value_type": "iso_date"
          },
          "required": true,
          "max_bytes": 10,
          "description": "The date of the counseling."
        },
        "purpose": {
          "type": "string",
          "required": false,
          "max_bytes": 600,
          "description": "What the counseling is for."
        },
        "form": {
          "type": "string",
          "required": false,
          "max_bytes": 8000,
          "description": "The prepared form."
        },
        "stored_at": {
          "type": "string",
          "required": false,
          "max_bytes": 300,
          "description": "Where the full form is kept, as a path relative to the teacher's work."
        }
      },
      "submission_criteria": [
        {
          "code": "student_missing",
          "message": "Apply register_student for this student first.",
          "all": [
            {
              "exists": "$student"
            }
          ]
        }
      ],
      "rules": [
        {
          "create_object": "counseling",
          "set": {
            "student": "$student",
            "date": "$date",
            "purpose": "$purpose",
            "form": "$form",
            "stored_at": "$stored_at",
            "status": "prepared"
          }
        }
      ]
    },
    "record_counseling": {
      "description": "Record the result of a counseling and set its status held.",
      "parameters": {
        "counseling": {
          "type": {
            "ref": "counseling"
          },
          "required": true,
          "description": "The counseling, keyed <slug>|<date>."
        },
        "result": {
          "type": "string",
          "required": true,
          "max_bytes": 8000,
          "description": "What the counseling found."
        }
      },
      "submission_criteria": [
        {
          "code": "counseling_missing",
          "message": "The counseling does not exist.",
          "all": [
            {
              "exists": "$counseling"
            }
          ]
        }
      ],
      "rules": [
        {
          "modify_object": "counseling",
          "set": {
            "result": "$result",
            "status": "held"
          }
        }
      ]
    },
    "close_counseling": {
      "description": "Close a counseling.",
      "parameters": {
        "counseling": {
          "type": {
            "ref": "counseling"
          },
          "required": true,
          "description": "The counseling, keyed <slug>|<date>."
        }
      },
      "submission_criteria": [
        {
          "code": "counseling_missing",
          "message": "The counseling does not exist.",
          "all": [
            {
              "exists": "$counseling"
            }
          ]
        }
      ],
      "rules": [
        {
          "modify_object": "counseling",
          "set": {
            "status": "closed"
          }
        }
      ]
    },
    "close_lesson_day": {
      "description": "Close a lesson day: the student's memory holds the server's records up to the date.",
      "parameters": {
        "student": {
          "type": {
            "ref": "student"
          },
          "required": true,
          "description": "The student, keyed by the slug the teacher's files use."
        },
        "lesson_date": {
          "type": {
            "value_type": "iso_date"
          },
          "required": true,
          "max_bytes": 10,
          "description": "The lesson date the memory now holds."
        },
        "updated_at": {
          "type": "string",
          "required": true,
          "max_bytes": 40,
          "description": "When the memory was written. A UTC time YYYY-MM-DDTHH:MM:SSZ set by the caller."
        }
      },
      "submission_criteria": [
        {
          "code": "student_missing",
          "message": "Apply register_student for this student first.",
          "all": [
            {
              "exists": "$student"
            }
          ]
        }
      ],
      "rules": [
        {
          "modify_object": "student",
          "set": {
            "memory_as_of": "$lesson_date",
            "updated_at": "$updated_at"
          }
        }
      ]
    }
  },
