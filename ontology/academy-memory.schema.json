    "retire_binding": {
      "description": "Retire a binding: the book is no longer the student's.",
      "parameters": {
        "student": {
          "type": {
            "ref": "student"
          },
          "required": true,
          "description": "The student, keyed by the slug the teacher's files use."
        },
        "binding": {
          "type": {
            "ref": "textbook_binding"
          },
          "required": true,
          "description": "The binding, keyed <slug>|<book_no>."
        }
      },
      "submission_criteria": [
        {
          "code": "student_missing",
          "message": "Apply register_student for this student first.",
          "all": [
            {
              "exists": "$student"
            }
          ]
        },
        {
          "code": "binding_missing",
          "message": "The binding does not exist.",
