{
  "format": "ontology-schema/v1",
  "domain": "academy_memory",
  "version": 1,
  "namespace": {
    "instance": "vps://palantirkc",
    "account": "root"
  },
  "scope_keys": [],
  "value_types": {
    "iso_date": {
      "base": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "key_digits": {
      "base": "string",
      "pattern": "^[0-9]{1,32}$"
    },
    "provenance": {
      "base": "string",
      "enum": [
        "server_observed",
        "teacher_confirmed",
        "local_state",
        "planned",
        "unconfirmed"
      ]
    },
    "student_status": {
      "base": "string",
      "enum": [
        "onboarding",
        "active",
        "paused",
        "transferred",
        "archived"
      ]
    },
    "binding_status": {
      "base": "string",
      "enum": [
        "active",
        "candidate",
        "retired"
      ]
    },
    "observation_kind": {
      "base": "string",
      "enum": [
        "dailyrecord",
        "prestudy",
        "prestudy_report",
        "section_results",
        "dailytest",
        "clinic",
        "metadata",
        "other"
      ]
    },
    "reminder_status": {
      "base": "string",
      "enum": [
        "open",
        "closed"
      ]
    },
    "counseling_status": {
      "base": "string",
      "enum": [
        "prepared",
        "held",
        "closed"
      ]
    }
  },
  "sources": {},
  "object_types": {
    "student": {
      "description": "A student as the teacher and the agent know them, with the date as of which the memory holds the server's records. Native key: the slug.",
      "owner": "ontology",
      "primary_key": {
        "from": "/native_key"
      },
      "title": "slug",
      "properties": {
        "slug": {
          "type": "string",
          "required": true,
          "max_bytes": 100,
          "description": "The slug the teacher's files use; the caller passes it equal to the native key. A view argument, so ASCII letters, digits and . _ : / - only."
        },
        "name": {
          "type": "string",
          "required": false,
          "max_bytes": 100,
          "description": "The name the teacher uses for the student."
        },
        "student_id": {
          "type": {
            "value_type": "key_digits"
          },
          "required": false,
          "max_bytes": 32,
          "description": "The Academy server's student id, by which the domains academy and academy_read know the same student."
        },
        "course_id": {
          "type": {
            "value_type": "key_digits"
          },
          "required": false,
          "max_bytes": 32,
          "description": "The Academy server's course id of the student."
        },
        "membership_id": {
          "type": {
            "value_type": "key_digits"
          },
          "required": false,
          "max_bytes": 32,
          "description": "The Academy server's course membership key of the student."
        },
        "status": {
          "type": {
            "value_type": "student_status"
          },
          "required": true,
          "description": "Where the student stands: onboarding, active, paused, transferred or archived."
        },
        "class_slot": {
          "type": "string",
          "required": false,
          "max_bytes": 100,
          "description": "The class the student attends, as the teacher names it."
        },
        "surface": {
          "type": "string",
          "required": false,
          "max_bytes": 2000,
          "description": "The few facts a lesson starts from."
        },
        "memory_as_of": {
          "type": {
            "value_type": "iso_date"
          },
          "required": false,
          "max_bytes": 10,
          "description": "The last lesson date whose records this memory holds; the server's records after it are not yet read."
        },
        "updated_at": {
          "type": "string",
          "required": false,
          "max_bytes": 40,
          "description": "When the student's memory was last written. A UTC time YYYY-MM-DDTHH:MM:SSZ set by the caller."
        }
      }
    },
    "textbook_binding": {
      "description": "A book the student works in, as read from the Academy server. Native key: <slug>|<book_no>.",
      "owner": "ontology",
      "primary_key": {
        "from": "/native_key"
      },
      "title": "book_label",
      "properties": {
        "student": {
          "type": {
            "ref": "student"
          },
          "required": true,
          "description": "The student, keyed by the slug the teacher's files use."
        },
        "book_no": {
          "type": {
            "value_type": "key_digits"
          },
          "required": true,
          "max_bytes": 32,
          "description": "The Academy server's book number."
        },
        "course_key": {
          "type": "string",
          "required": false,
          "max_bytes": 40,
          "description": "The Academy server's course key of the book."
        },
        "book_label": {
          "type": "string",
          "required": false,
          "max_bytes": 600,
          "description": "The book's label word for word as the Academy's server names it."
        },
        "role": {
          "type": "string",
          "required": false,
          "max_bytes": 200,
          "description": "What the book is for in the student's lessons."
        },
        "status": {
          "type": {
            "value_type": "binding_status"
          },
          "required": true,
          "description": "active, candidate or retired."
        },
        "provenance": {
          "type": {
            "value_type": "provenance"
          },
          "required": false,
          "description": "Where the reading comes from."
        },
        "observed_at": {
          "type": "string",
          "required": false,
          "max_bytes": 40,
          "description": "When the binding was read. A UTC time YYYY-MM-DDTHH:MM:SSZ set by the caller."
        }
      }
    },
    "observation": {
      "description": "One reading of one Academy server record with its kind, its record id and its time. Native key: given by the caller.",
      "owner": "ontology",
      "primary_key": {
        "from": "/native_key"
      },
      "title": "summary",
      "properties": {
        "student": {
          "type": {
            "ref": "student"
          },
          "required": true,
          "description": "The student, keyed by the slug the teacher's files use."
        },
        "kind": {
          "type": {
            "value_type": "observation_kind"
          },
          "required": true,
          "description": "What the Academy server's record is."
        },
        "lesson_date": {
          "type": {
            "value_type": "iso_date"
          },
          "required": true,
          "max_bytes": 10,
          "description": "The lesson date the record belongs to."
        },
        "observed_at": {
          "type": "string",
          "required": true,
          "max_bytes": 40,
          "description": "When the record was read. A UTC time YYYY-MM-DDTHH:MM:SSZ set by the caller."
        },
        "tool": {
          "type": "string",
          "required": false,
          "max_bytes": 100,
          "description": "The tool of the Academy server that answered the record."
        },
        "record_id": {
          "type": "string",
          "required": false,
          "max_bytes": 100,
          "description": "The Academy server's id of the record, by which a later reading links the two."
        },
        "summary": {
          "type": "string",
          "required": true,
          "max_bytes": 1500,
          "description": "What the record says, in short."
        }
      }
    },
    "lesson_note": {
      "description": "The teacher's or the agent's note of one lesson day. Native key: <slug>|<lesson_date>.",
      "owner": "ontology",
      "primary_key": {
        "from": "/native_key"
      },
      "title": "lesson_date",
      "properties": {
        "student": {
          "type": {
            "ref": "student"
          },
          "required": true,
          "description": "The student, keyed by the slug the teacher's files use."
        },
        "lesson_date": {
          "type": {
            "value_type": "iso_date"
          },
          "required": true,
          "max_bytes": 10,
          "description": "The lesson date of the note."
        },
        "text": {
          "type": "string",
          "required": true,
          "max_bytes": 8000,
          "description": "The note of the lesson."
        },
        "provenance": {
          "type": {
            "value_type": "provenance"
          },
          "required": true,
          "description": "Where the note comes from."
        },
        "written_at": {
          "type": "string",
          "required": false,
          "max_bytes": 40,
          "description": "When the note was written. A UTC time YYYY-MM-DDTHH:MM:SSZ set by the caller."
        }
      }
    },
    "reminder": {
      "description": "Something to remember for a student or a whole class. Native key: the reminder's id.",
      "owner": "ontology",
      "primary_key": {
        "from": "/native_key"
      },
      "title": "text",
      "properties": {
        "student": {
          "type": {
            "ref": "student"
          },
          "required": false,
          "description": "The student; absent for a reminder of a whole class."
        },
        "text": {
          "type": "string",
          "required": true,
          "max_bytes": 600,
          "description": "What to remember."
        },
        "status": {
          "type": {
            "value_type": "reminder_status"
          },
          "required": true,
          "description": "open or closed."
        },
        "due": {
          "type": {
            "value_type": "iso_date"
          },
          "required": false,
          "max_bytes": 10,
          "description": "The date by which it is due."
        },
        "provenance": {
          "type": {
            "value_type": "provenance"
          },
          "required": false,
          "description": "Where the reminder comes from."
        },
        "updated_at": {
          "type": "string",
          "required": false,
          "max_bytes": 40,
          "description": "When the reminder was last written. A UTC time YYYY-MM-DDTHH:MM:SSZ set by the caller."
        }
      }
    },
    "counseling": {
      "description": "One counseling of a student: its form, its result and its state. Native key: <slug>|<date>.",
      "owner": "ontology",
      "primary_key": {
        "from": "/native_key"
      },
      "title": "date",
      "properties": {
        "student": {
          "type": {
            "ref": "student"
          },
          "required": true,
          "description": "The student, keyed by the slug the teacher's files use."
        },
        "date": {
          "type": {
            "value_type": "iso_date"
          },
          "required": true,
          "max_bytes": 10,
          "description": "The date of the counseling."
        },
        "purpose": {
          "type": "string",
          "required": false,
          "max_bytes": 600,
          "description": "What the counseling is for."
        },
        "form": {
          "type": "string",
          "required": false,
          "max_bytes": 8000,
          "description": "The prepared form."
        },
        "result": {
          "type": "string",
          "required": false,
          "max_bytes": 8000,
          "description": "What the counseling found."
        },
        "status": {
          "type": {
            "value_type": "counseling_status"
          },
          "required": true,
          "description": "prepared, held or closed."
        },
        "stored_at": {
          "type": "string",
          "required": false,
          "max_bytes": 300,
          "description": "Where the full form is kept, as a path relative to the teacher's work."
        }
      }
    }
  },
  "link_types": {
    "binding_student": {
      "from": "textbook_binding",
      "via": "student",
      "to": "student",
      "cardinality": "many_to_one",
      "names": {
        "forward": "binding_student",
        "reverse": "bindings"
      }
    },
    "observation_student": {
      "from": "observation",
      "via": "student",
      "to": "student",
      "cardinality": "many_to_one",
      "names": {
        "forward": "observation_student",
        "reverse": "observations"
      }
    },
    "note_student": {
      "from": "lesson_note",
      "via": "student",
      "to": "student",
      "cardinality": "many_to_one",
      "names": {
        "forward": "note_student",
        "reverse": "lesson_notes"
      }
    },
    "reminder_student": {
      "from": "reminder",
      "via": "student",
      "to": "student",
      "cardinality": "many_to_one",
      "names": {
        "forward": "reminder_student",
        "reverse": "reminders"
      }
    },
    "counseling_student": {
      "from": "counseling",
      "via": "student",
      "to": "student",
      "cardinality": "many_to_one",
      "names": {
        "forward": "counseling_student",
        "reverse": "counselings"
      }
    }
  },
  "action_types": {
    "register_student": {
      "description": "Create or modify a student from its properties; a property left out keeps its value.",
      "parameters": {
        "student": {
          "type": {
            "ref": "student"
          },
          "required": true,
          "description": "The student, keyed by the slug the teacher's files use."
        },
