          "max_bytes": 40,
          "description": "When the student's memory was last written. A UTC time YYYY-MM-DDTHH:MM:SSZ set by the caller."
        }
      },
      "submission_criteria": [],
      "rules": [
        {
          "create_or_modify_object": "student",
          "set": {
            "slug": "$slug",
            "name": "$name",
            "student_id": "$student_id",
            "course_id": "$course_id",
            "membership_id": "$membership_id",
            "status": "$status",
            "class_slot": "$class_slot",
            "surface": "$surface",
            "memory_as_of": "$memory_as_of",
            "updated_at": "$updated_at"
          }
        }
      ]
    },
    "set_surface": {
      "description": "Set the few facts a lesson starts from.",
      "parameters": {
        "student": {
          "type": {
            "ref": "student"
          },
          "required": true,
          "description": "The student, keyed by the slug the teacher's files use."
        },
        "surface": {
          "type": "string",
          "required": true,
          "max_bytes": 2000,
          "description": "The few facts a lesson starts from."
        }
      },
      "submission_criteria": [
        {
          "code": "student_missing",
          "message": "Apply register_student for this student first.",
          "all": [
            {
              "exists": "$student"
            }
          ]
        }
      ],
      "rules": [
        {
          "modify_object": "student",
          "set": {
            "surface": "$surface"
          }
        }
      ]
    },
    "bind_textbook": {
