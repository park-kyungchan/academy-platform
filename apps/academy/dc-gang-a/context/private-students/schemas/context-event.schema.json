{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "academy.context-event/1",
  "type": "object",
  "required": ["schemaVersion", "eventId", "businessDate", "session", "seq", "type", "student", "fact", "source", "sourceRef", "status"],
  "properties": {
    "schemaVersion": {"const": "academy.context-event/1"},
    "eventId": {"type": "string", "minLength": 1},
    "businessDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "session": {"type": "string", "minLength": 1},
    "seq": {"type": "integer", "minimum": 1},
    "type": {"enum": ["attendance_observed", "homework_checked", "homework_assigned", "teacher_decision", "assessment_observed", "source_observation_failed", "reminder_scheduled", "interview_pending"]},
    "student": {
      "type": "object",
      "required": ["name", "nativeId"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "nativeId": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "fact": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "sourceRef": {"type": "string", "minLength": 1},
    "status": {"enum": ["confirmed", "partially_confirmed", "unknown_preserved"]},
    "unknown": {"type": "array", "items": {"type": "string"}},
    "detail": {"type": "object"}
  },
  "additionalProperties": false
}
