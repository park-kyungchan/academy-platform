{
  "schemaVersion": 1,
  "kind": "student_evidence_history_design_contract",
  "contractVersion": "1",
  "status": "design_schema_conformance_verified_no_runtime_or_production_store",
  "targetArchitecture": "docs/academy-whole-lens-target-architecture.json",
  "schemaDialect": "http://json-schema.org/draft-07/schema#",
  "owner": "dc-gang-a-dev",
  "definitions": {
    "OpaqueId": {"type":"string","minLength":1,"maxLength":200},
    "EvidenceRefs": {"type":"array","minItems":1,"maxItems":100,"uniqueItems":true,"items":{"$ref":"#/definitions/OpaqueId"}},
    "Unknown": {"type":"object","additionalProperties":false,"required":["state","reason"],"properties":{"state":{"const":"unknown"},"reason":{"type":"string","minLength":1,"maxLength":2000}}},
    "KnowledgeString": {"oneOf":[{"$ref":"#/definitions/Unknown"},{"type":"object","additionalProperties":false,"required":["state","value","evidenceRefs"],"properties":{"state":{"const":"known"},"value":{"$ref":"#/definitions/OpaqueId"},"evidenceRefs":{"$ref":"#/definitions/EvidenceRefs"}}}]},
    "KnowledgeBoolean": {"oneOf":[{"$ref":"#/definitions/Unknown"},{"type":"object","additionalProperties":false,"required":["state","value","evidenceRefs"],"properties":{"state":{"const":"known"},"value":{"type":"boolean"},"evidenceRefs":{"$ref":"#/definitions/EvidenceRefs"}}}]},
    "KnowledgeIds": {"oneOf":[{"$ref":"#/definitions/Unknown"},{"type":"object","additionalProperties":false,"required":["state","value","evidenceRefs"],"properties":{"state":{"const":"known"},"value":{"type":"array","maxItems":100,"uniqueItems":true,"items":{"$ref":"#/definitions/OpaqueId"}},"evidenceRefs":{"$ref":"#/definitions/EvidenceRefs"}}}]},
    "Partition": {"type":"object","additionalProperties":false,"required":["ownerId","studentId"],"properties":{"ownerId":{"$ref":"#/definitions/OpaqueId"},"studentId":{"$ref":"#/definitions/OpaqueId"}}},
    "SourceKey": {"type":"object","additionalProperties":false,"required":["namespace","literalKey"],"properties":{"namespace":{"$ref":"#/definitions/OpaqueId"},"literalKey":{"$ref":"#/definitions/OpaqueId"}}},
    "ContentScope": {"type":"object","additionalProperties":false,"required":["editionId","unitId","pageIds","problemIds"],"properties":{"editionId":{"$ref":"#/definitions/KnowledgeString"},"unitId":{"$ref":"#/definitions/KnowledgeString"},"pageIds":{"$ref":"#/definitions/KnowledgeIds"},"problemIds":{"$ref":"#/definitions/KnowledgeIds"}}},
    "Instant": {"type":"string","format":"date-time"},
    "LocalDate": {"type":"string","format":"date"},
    "KnowledgeSourceKey": {"oneOf":[{"$ref":"#/definitions/Unknown"},{"type":"object","additionalProperties":false,"required":["state","value","evidenceRefs"],"properties":{"state":{"const":"known"},"value":{"$ref":"#/definitions/SourceKey"},"evidenceRefs":{"$ref":"#/definitions/EvidenceRefs"}}}]},
    "TemporalLiteral": {"type":"object","additionalProperties":false,"required":["literal","precision","timeZone","meaning"],"properties":{"literal":{"type":"string","minLength":1,"maxLength":200},"precision":{"enum":["unknown","month_day","date","minute","second"]},"timeZone":{"$ref":"#/definitions/KnowledgeString"},"meaning":{"enum":["event_time","source_apply_date","source_grade_time","teacher_approval_time","reported_time"]}}},
    "KnowledgeTime": {"oneOf":[{"$ref":"#/definitions/Unknown"},{"type":"object","additionalProperties":false,"required":["state","value","evidenceRefs"],"properties":{"state":{"const":"known"},"value":{"$ref":"#/definitions/TemporalLiteral"},"evidenceRefs":{"$ref":"#/definitions/EvidenceRefs"}}}]},
    "AssessmentItemOutcome": {"type":"object","additionalProperties":false,"required":["originalOrdinal","sourceItem","storedResult"],"properties":{"originalOrdinal":{"$ref":"#/definitions/OpaqueId"},"sourceItem":{"$ref":"#/definitions/KnowledgeSourceKey"},"storedResult":{"enum":["O","X"]}}},
    "AssessmentAttempt": {"type":"object","additionalProperties":false,"required":["kind","entityId","partition","sourceAttempt","sourcePaper","occurrenceId","scope","sourceTime","observedAt","originalScore","contractRef","items"],"properties":{"kind":{"const":"assessment_attempt"},"entityId":{"$ref":"#/definitions/OpaqueId"},"partition":{"$ref":"#/definitions/Partition"},"sourceAttempt":{"$ref":"#/definitions/SourceKey"},"sourcePaper":{"$ref":"#/definitions/KnowledgeSourceKey"},"occurrenceId":{"$ref":"#/definitions/KnowledgeString"},"scope":{"$ref":"#/definitions/ContentScope"},"sourceTime":{"$ref":"#/definitions/KnowledgeTime"},"observedAt":{"$ref":"#/definitions/Instant"},"originalScore":{"type":"number","minimum":0,"maximum":100},"contractRef":{"$ref":"#/definitions/OpaqueId"},"items":{"type":"array","minItems":1,"maxItems":1000,"uniqueItems":true,"items":{"$ref":"#/definitions/AssessmentItemOutcome"}}}},
    "Digest": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "OptionalRefs": {"type":"array","maxItems":100,"uniqueItems":true,"items":{"$ref":"#/definitions/OpaqueId"}},
    "TeacherPayload": {
      "type":"object","additionalProperties":false,
      "required":["recordKind","assertion","statement","occurrenceId","scope","evidenceRefs","reviewedTargets"],
      "properties":{"recordKind":{"enum":["teacher_note","model_draft","concept_blank_test","inspection","approval","correction"]},"assertion":{"enum":["draft","reported","not_performed","teacher_inspected","approved","retracted"]},"statement":{"type":"string","minLength":1,"maxLength":16000},"occurrenceId":{"$ref":"#/definitions/KnowledgeString"},"scope":{"$ref":"#/definitions/ContentScope"},"evidenceRefs":{"$ref":"#/definitions/OptionalRefs"},"reviewedTargets":{"$ref":"#/definitions/OptionalRefs"}},
      "allOf":[
        {"if":{"properties":{"recordKind":{"const":"inspection"}}},"then":{"properties":{"assertion":{"const":"teacher_inspected"},"evidenceRefs":{"minItems":1},"reviewedTargets":{"minItems":1}}}},
        {"if":{"properties":{"recordKind":{"const":"model_draft"}}},"then":{"properties":{"assertion":{"const":"draft"}}}},
        {"if":{"properties":{"assertion":{"const":"teacher_inspected"}}},"then":{"properties":{"recordKind":{"const":"inspection"}}}},
        {"if":{"properties":{"recordKind":{"const":"approval"}}},"then":{"properties":{"assertion":{"const":"approved"},"evidenceRefs":{"minItems":1}}}}
      ]
    },
    "TeacherRevision": {
      "type":"object","additionalProperties":false,
      "required":["schemaVersion","kind","partition","revisionId","entityId","sequence","previousRevisionId","previousDigest","idempotencyKey","actorId","actorRole","recordedAt","reason","commandDigest","integrityDigest","payload"],
      "properties":{"schemaVersion":{"const":1},"kind":{"const":"teacher_revision"},"partition":{"$ref":"#/definitions/Partition"},"revisionId":{"$ref":"#/definitions/OpaqueId"},"entityId":{"$ref":"#/definitions/OpaqueId"},"sequence":{"type":"integer","minimum":1},"previousRevisionId":{"anyOf":[{"type":"null"},{"$ref":"#/definitions/OpaqueId"}]},"previousDigest":{"anyOf":[{"type":"null"},{"$ref":"#/definitions/Digest"}]},"idempotencyKey":{"$ref":"#/definitions/OpaqueId"},"actorId":{"$ref":"#/definitions/OpaqueId"},"actorRole":{"enum":["teacher","agent_draft"]},"recordedAt":{"$ref":"#/definitions/Instant"},"reason":{"type":"string","minLength":1,"maxLength":2000},"commandDigest":{"$ref":"#/definitions/Digest"},"integrityDigest":{"$ref":"#/definitions/Digest"},"payload":{"$ref":"#/definitions/TeacherPayload"}},
      "allOf":[
        {"if":{"properties":{"sequence":{"const":1}}},"then":{"properties":{"previousRevisionId":{"type":"null"},"previousDigest":{"type":"null"}}},"else":{"properties":{"previousRevisionId":{"$ref":"#/definitions/OpaqueId"},"previousDigest":{"$ref":"#/definitions/Digest"}}}},
        {"if":{"properties":{"actorRole":{"const":"agent_draft"}}},"then":{"properties":{"payload":{"properties":{"recordKind":{"const":"model_draft"},"assertion":{"const":"draft"}}}}}}
      ]
    },
    "ActivityKind": {"enum":["concept_blank_test","original_practice","wrong_clinic","similar_clinic","daily_test","prestudy","unit_assessment","diagnostic_assessment","smartbook_practice","teacher_followup"]},
    "KnowledgeDate": {"oneOf":[{"$ref":"#/definitions/Unknown"},{"type":"object","additionalProperties":false,"required":["state","value","evidenceRefs"],"properties":{"state":{"const":"known"},"value":{"$ref":"#/definitions/LocalDate"},"evidenceRefs":{"$ref":"#/definitions/EvidenceRefs"}}}]},
    "IdentityBinding": {"type":"object","additionalProperties":false,"required":["kind","entityId","partition","sourceKey","bindingState","validFrom","validUntil","proofRefs","contractRef"],"properties":{"kind":{"const":"identity_binding"},"entityId":{"$ref":"#/definitions/OpaqueId"},"partition":{"$ref":"#/definitions/Partition"},"sourceKey":{"$ref":"#/definitions/SourceKey"},"bindingState":{"enum":["proposed","verified","rejected"]},"validFrom":{"$ref":"#/definitions/LocalDate"},"validUntil":{"$ref":"#/definitions/KnowledgeDate"},"proofRefs":{"$ref":"#/definitions/OptionalRefs"},"contractRef":{"$ref":"#/definitions/OpaqueId"}},"allOf":[{"if":{"properties":{"bindingState":{"const":"verified"}}},"then":{"properties":{"proofRefs":{"minItems":1}}}}]},
    "BookAssignment": {"type":"object","additionalProperties":false,"required":["kind","entityId","partition","editionId","validFrom","validUntil","authoredBy","evidenceRefs"],"properties":{"kind":{"const":"book_assignment"},"entityId":{"$ref":"#/definitions/OpaqueId"},"partition":{"$ref":"#/definitions/Partition"},"editionId":{"$ref":"#/definitions/KnowledgeString"},"validFrom":{"$ref":"#/definitions/LocalDate"},"validUntil":{"$ref":"#/definitions/KnowledgeDate"},"authoredBy":{"enum":["source","teacher"]},"evidenceRefs":{"$ref":"#/definitions/EvidenceRefs"}}},
    "LessonOccurrence": {"type":"object","additionalProperties":false,"required":["kind","entityId","partition","lessonDate","timeZone","sessionKind","sourceRecord","courseRef","membershipRef","makeupFor","evidenceRefs"],"properties":{"kind":{"const":"lesson_occurrence"},"entityId":{"$ref":"#/definitions/OpaqueId"},"partition":{"$ref":"#/definitions/Partition"},"lessonDate":{"$ref":"#/definitions/LocalDate"},"timeZone":{"$ref":"#/definitions/OpaqueId"},"sessionKind":{"enum":["lesson","makeup"]},"sourceRecord":{"$ref":"#/definitions/SourceKey"},"courseRef":{"$ref":"#/definitions/KnowledgeSourceKey"},"membershipRef":{"$ref":"#/definitions/KnowledgeSourceKey"},"makeupFor":{"$ref":"#/definitions/KnowledgeString"},"evidenceRefs":{"$ref":"#/definitions/EvidenceRefs"}}},
    "ActivityAssignment": {"type":"object","additionalProperties":false,"required":["kind","entityId","partition","activityKind","purpose","status","occurrenceId","scope","dueTime","paperRef","teacherBasisRefs"],"properties":{"kind":{"const":"activity_assignment"},"entityId":{"$ref":"#/definitions/OpaqueId"},"partition":{"$ref":"#/definitions/Partition"},"activityKind":{"$ref":"#/definitions/ActivityKind"},"purpose":{"enum":["lesson","homework","prestudy","review","makeup"]},"status":{"enum":["draft","approved","cancelled"]},"occurrenceId":{"$ref":"#/definitions/KnowledgeString"},"scope":{"$ref":"#/definitions/ContentScope"},"dueTime":{"$ref":"#/definitions/KnowledgeTime"},"paperRef":{"$ref":"#/definitions/KnowledgeString"},"teacherBasisRefs":{"$ref":"#/definitions/OptionalRefs"}},"allOf":[{"if":{"properties":{"status":{"const":"approved"}}},"then":{"properties":{"teacherBasisRefs":{"minItems":1}}}}]},
    "SourceEvidence": {
      "type":"object","additionalProperties":false,
      "required":["kind","entityId","partition","activityKind","stage","assertion","sourceRecord","occurrenceId","scope","sourceTime","observedAt","contractRef","evidenceRefs","teacherDirective","mediaRefs","summary"],
      "properties":{"kind":{"const":"source_evidence"},"entityId":{"$ref":"#/definitions/OpaqueId"},"partition":{"$ref":"#/definitions/Partition"},"activityKind":{"$ref":"#/definitions/ActivityKind"},"stage":{"enum":["assignment","generation","physical_provision","written_solving","app_entry","stored_grade","media_upload","watch_history","teacher_report"]},"assertion":{"enum":["observed","reported","not_performed"]},"sourceRecord":{"$ref":"#/definitions/KnowledgeSourceKey"},"occurrenceId":{"$ref":"#/definitions/KnowledgeString"},"scope":{"$ref":"#/definitions/ContentScope"},"sourceTime":{"$ref":"#/definitions/KnowledgeTime"},"observedAt":{"$ref":"#/definitions/Instant"},"contractRef":{"$ref":"#/definitions/OpaqueId"},"evidenceRefs":{"$ref":"#/definitions/EvidenceRefs"},"teacherDirective":{"$ref":"#/definitions/KnowledgeString"},"mediaRefs":{"$ref":"#/definitions/OptionalRefs"},"summary":{"type":"string","minLength":1,"maxLength":16000}},
      "allOf":[{"if":{"properties":{"assertion":{"const":"not_performed"}}},"then":{"properties":{"stage":{"const":"teacher_report"},"teacherDirective":{"properties":{"state":{"const":"known"}}}}}}]
    },
    "PaperInstance": {"type":"object","additionalProperties":false,"required":["kind","entityId","ownerId","resourceKind","sourcePaper","originPaper","scope","sourceVersion","printedRepresentation","evidenceRefs"],"properties":{"kind":{"const":"paper_instance"},"entityId":{"$ref":"#/definitions/OpaqueId"},"ownerId":{"$ref":"#/definitions/OpaqueId"},"resourceKind":{"enum":["original","wrong_clinic","similar_clinic","advance_clinic"]},"sourcePaper":{"$ref":"#/definitions/KnowledgeSourceKey"},"originPaper":{"$ref":"#/definitions/KnowledgeSourceKey"},"scope":{"$ref":"#/definitions/ContentScope"},"sourceVersion":{"$ref":"#/definitions/KnowledgeString"},"printedRepresentation":{"$ref":"#/definitions/KnowledgeString"},"evidenceRefs":{"$ref":"#/definitions/EvidenceRefs"}}},
    "CarryoverRelation": {"type":"object","additionalProperties":false,"required":["kind","entityId","partition","fromAssignmentRef","targetOccurrence","relationKind","teacherRevisionRef","scope"],"properties":{"kind":{"const":"carryover_relation"},"entityId":{"$ref":"#/definitions/OpaqueId"},"partition":{"$ref":"#/definitions/Partition"},"fromAssignmentRef":{"$ref":"#/definitions/OpaqueId"},"targetOccurrence":{"$ref":"#/definitions/KnowledgeString"},"relationKind":{"enum":["classroom_carryover","new_homework","review","makeup"]},"teacherRevisionRef":{"$ref":"#/definitions/OpaqueId"},"scope":{"$ref":"#/definitions/ContentScope"}}},
    "UnresolvedIntake": {"type":"object","additionalProperties":false,"required":["kind","entityId","ownerId","sourceRecord","candidateStudentIds","issue","summary","evidenceRefs","observedAt"],"properties":{"kind":{"const":"unresolved_intake"},"entityId":{"$ref":"#/definitions/OpaqueId"},"ownerId":{"$ref":"#/definitions/OpaqueId"},"sourceRecord":{"$ref":"#/definitions/SourceKey"},"candidateStudentIds":{"$ref":"#/definitions/KnowledgeIds"},"issue":{"enum":["duplicate_name","missing_source_binding","unknown_namespace","source_conflict","missing_occurrence","missing_content"]},"summary":{"type":"string","minLength":1,"maxLength":2000},"evidenceRefs":{"$ref":"#/definitions/EvidenceRefs"},"observedAt":{"$ref":"#/definitions/Instant"}}},
    "ObservedQueryScope": {"oneOf":[{"type":"object","additionalProperties":false,"required":["kind","localDate","timeZone"],"properties":{"kind":{"const":"class_date"},"localDate":{"$ref":"#/definitions/LocalDate"},"timeZone":{"$ref":"#/definitions/OpaqueId"}}},{"type":"object","additionalProperties":false,"required":["kind","studentId","fromDate","toDate","timeZone"],"properties":{"kind":{"const":"student_period"},"studentId":{"$ref":"#/definitions/OpaqueId"},"fromDate":{"$ref":"#/definitions/LocalDate"},"toDate":{"$ref":"#/definitions/LocalDate"},"timeZone":{"$ref":"#/definitions/OpaqueId"}}}]},
    "CoverageObservation": {"type":"object","additionalProperties":false,"required":["kind","entityId","ownerId","requestedScope","sourceContractRef","expectedTargets","observedRefs","observedCount","coverage","observedAt","evidenceRefs","meaning"],"properties":{"kind":{"const":"coverage_observation"},"entityId":{"$ref":"#/definitions/OpaqueId"},"ownerId":{"$ref":"#/definitions/OpaqueId"},"requestedScope":{"$ref":"#/definitions/ObservedQueryScope"},"sourceContractRef":{"$ref":"#/definitions/OpaqueId"},"expectedTargets":{"$ref":"#/definitions/KnowledgeIds"},"observedRefs":{"$ref":"#/definitions/OptionalRefs"},"observedCount":{"type":"integer","minimum":0,"maximum":1000},"coverage":{"enum":["unknown","not_observed","partially_observed","fully_observed","conflict"]},"observedAt":{"$ref":"#/definitions/Instant"},"evidenceRefs":{"$ref":"#/definitions/EvidenceRefs"},"meaning":{"const":"absence_of_rows_does_not_establish_not_performed"}}}
  },
  "recordGroups": {
    "studentBound": ["IdentityBinding","BookAssignment","LessonOccurrence","ActivityAssignment","SourceEvidence","AssessmentAttempt","TeacherRevision","CarryoverRelation"],
    "ownerSharedResource": ["PaperInstance"],
    "ownerProtectedUnresolved": ["UnresolvedIntake"],
    "ownerProtectedCoverage": ["CoverageObservation"],
    "existingSharedCatalog": "Reuse LearningCatalog editions/units/pages/problems; no per-student catalog copy."
  },
  "fieldMeaning": {
    "AssessmentAttempt.originalScore": "The unmodified literal source score of this retained observation/version. It does not establish the earliest submission/grade or a complete regrade chronology when those versions/times are unavailable; preserve them as unknown. Later teacher inspection never overwrites this source snapshot.",
    "TeacherRevision.actorRole": "Trusted writer-produced attribution in the output DTO, not a client-selected authority or cryptographic proof. Separate capture-actor metadata is required when recording a teacher directive through an agent.",
    "PaperInstance": "Owner/shared resource definition. Student assignment, generation, physical provision/print and solving require independent linked evidence; the resource record alone certifies none.",
    "CoverageObservation": "Minimal retained evidence of a consequential query scope/result. A requested student filter is not source-to-student binding proof, and an empty result is not not_performed."
  },
  "queryDesign": [
    {"name":"class_preparation","scope":"Authenticated owner, explicit local date/time zone, all admitted groups/pages and regular/makeup/absence lanes.","result":"Every observed scheduled occurrence, source-specific freshness/coverage and separate activity/evidence/teacher review rows; unknown roster completeness is visible."},
    {"name":"student_learning","scope":"One admitted student plus bounded local period and optional exact content/activity filters.","result":"Hierarchical student/lesson/content view referencing original attempts, independent evidence dimensions, teacher revisions and unresolved candidate references."},
    {"name":"evidence_explanation","scope":"An authorized scene and exact evidence/claim reference from that scene.","result":"Source record/contract and mapping versions, literal time precision, derived-rule basis, conflict/unknown reason and teacher correction lineage."},
    {"name":"student_revision_history","scope":"One admitted student/entity, explicit revision or bounded sequence range.","result":"Original accepted-time evidence and successive teacher revisions, including corrections/compensations; not the current-state-only timeline wrapper."}
  ],
  "storageAndApplicationGuards": {
    "status":"required_future_implementation_not_exercised_by_schema_tests",
    "partition":"Derive owner and authenticated actor from the trusted ingress, not tool input. Enforce all record and evidence-reference partitions and effective bindings in the Backend/store.",
    "unresolved":"A name-only or unknown binding enters protected unresolved intake, not a guessed student partition. Resolution appends mapping/evidence history; it does not rewrite a prior student's partition.",
    "revisions":"Every retained source snapshot and teacher change needs an append-only version envelope. Reuse expected-head/idempotency/command-digest semantics from learning/revisions; adapt the expanded payload union explicitly. TeacherRevision is a proposed DTO, not an already-compatible LearningRevision.",
    "atomicWrite":"Reload current head, validate exact caller/scope/catalog/reference/time invariants, compare expected revision and retry digest, append and read back atomically. An uncertain outcome keeps its original request identity; no blind retry or invented acknowledgement.",
    "crossFieldChecks":["Partition equality across evidence and revisions", "Exact source-key namespace/cardinality/effective period", "Concrete catalog targets for completion reconciliation", "Unique original ordinal per attempt, even if another field differs", "Literal source score and independent grade/teacher clocks", "Known IANA/local-date semantics without invented timezone conversion", "Human attribution and confirmed target scope for inspection/not_performed/approval", "Revision chain, command/digest and complete retained history integrity"],
    "indexes":["ownerId/studentId/entityId/revision sequence", "ownerId/source namespace/literal key/effective period", "ownerId/studentId/lesson date/occurrence", "ownerId/studentId/attempt and original item ordinal", "ownerId/studentId/edition-unit-page-problem references", "ownerId/studentId/idempotency key and command digest"],
    "retention":"Only minimized decision-relevant source snapshots, original teacher input/decisions and necessary revision history; no credentials, native transcript mirror or unnecessary media copy. Persist a CoverageObservation only when an empty/partial scope supports a consequential retained claim. It is not an unconditional per-read ledger; ordinary derived caches remain expendable.",
    "recovery":"Acknowledgements distinguish input_received, history_saved_read_back, independent_copy_verified and restore_verified. No such operational claim is established by JSON Schema validation.",
    "bounds":"Array/text limits are proposed per-payload safety bounds, not teacher workload thresholds or measured SLAs. Larger scopes require explicit pagination/continuation; never silently clip and claim completeness."
  },
  "reuse": [
    {"source":"src/learning/model.ts","symbols":["Knowledge","ContentScope","LessonContext","StudentBookAssignment","LearningCatalog"],"meaning":"Reuse known/unknown evidence and verified catalog semantics; schema representations are design DTOs, not a replacement implementation."},
    {"source":"src/learning/revisions.ts","symbols":["RevisionCommand","LearningRevision","previewRevision","currentRevisions"],"meaning":"Preserve expected-head, idempotency and append-only history; the current payload union does not yet include all proposed records."}
  ],
  "limits": [
    "JSON Schema validates serialized shape, not authenticated ownership, source joins, event meaning, atomic writes or recovery.",
    "Opaque source keys are strings and are not repaired or normalized; a specific numeric renderer retains its independently reviewed stricter wire contract.",
    "Known empty page/problem arrays do not establish a concrete reconciliation target.",
    "No production DB, student ingestion, source acquisition, runtime writer or WebMCP registration is created by these design schemas."
  ]
}
